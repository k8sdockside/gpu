        "check": "npm run typecheck && npm run test && node scripts/build.mjs --check"
    },
    "devDependencies": {
        "esbuild": "0.28.2",
        "happy-dom": "^20.0.0",
        "typescript": "^6.0.3",
        "vitest": "^4.1.11"
