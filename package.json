{
    "name": "k8sdockside-gpu-plugin",
    "version": "1.0.0",
    "private": true,
    "description": "The GPU & Accelerators plugin for K8s Dockside: every GPU and device, through device plugins or DRA, and who is using it.",
    "license": "Apache-2.0",
    "author": "K8s Dockside",
    "repository": {
        "type": "git",
        "url": "https://github.com/k8sdockside/gpu"
    },
    "type": "module",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build": "node scripts/build.mjs",
        "watch": "node scripts/build.mjs --watch",
        "preview": "node scripts/preview.mjs",
